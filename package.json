{
  "name": "murmur-hash",
  "version": "2.1.0",
  "description": "MurmurHash3 x86 32-bit, x86 128-bit and x64 128-bit, matching the C++ reference and Python mmh3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --import tsx test/*.test.ts",
    "bench": "tsx bench/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "murmur",
    "murmurhash",
    "murmurhash3",
    "hash",
    "128-bit",
    "non-cryptographic",
    "fingerprint",
    "bloom-filter",
    "mmh3",
    "murmur3",
    "x64",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1mb-dev/murmur-hash.git"
  },
  "author": "1mb-dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/1mb-dev/murmur-hash/issues"
  },
  "homepage": "https://github.com/1mb-dev/murmur-hash#readme",
  "engines": {
    "node": ">=22"
  }
}
